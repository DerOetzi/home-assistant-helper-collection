flowchart TD
    T1([sunrise + offset])
    T2([pv_ready\nNetzeinspeisung > Schwelle, for: 5min])
    T3([soc_working_floor\nSoC <= Backup-Reserve + Offset])
    T3b([soc_working_limit\nSoC >= Backup-Reserve + Arbeitsreserve])
    T4([peak\nnow >= optimal_start])
    T5([fallback_peak\nfeste Uhrzeit z.B. 15:00])
    T6([sundown])
    T7([mode_changed\ninput_select Betriebsart])
    T8([inverter_changed\nReadback des Wechselrichters])
    T9([sweep\nalle 15 min])
    T10([reminder 07:00])
    T11([set_discharge / set_peak\nNotification-Action])
    T12([ha_start])

    T1 --> A
    T2 --> A
    T3 --> A
    T3b --> A
    T4 --> A
    T5 --> A
    T6 --> A
    T7 --> A
    T8 --> A
    T9 --> A
    T10 --> A
    T11 --> A
    T12 --> A

    A["Actions"] --> G1{"trigger = set_discharge\noder set_peak?"}
    G1 -->|ja| M1["Betriebsart setzen\n+ stop"]
    M1 --> E1([Ende])

    G1 -->|nein| G2{"trigger = reminder\nund Betriebsart = Aus?"}
    G2 -->|ja| M2["Notify: 2 Aktionsbuttons\n+ stop"]
    M2 --> E2([Ende])

    G2 -->|nein| PF["Peak-Merker pflegen"]
    PF --> PF1{"sundown / sunrise\noder Sonne unten?"}
    PF1 -->|ja| PFA["Merker aus"]
    PF1 -->|nein| PF2{"charge_due und Sonne oben\nund Betriebsart aktiv?"}
    PF2 -->|ja| PFB["Merker an"]

    PFA --> D0
    PFB --> D0
    PF2 -->|nein| D0

    D0{"Sollmodus herleiten"}

    D0 -->|"Betriebsart = Aus\noder Sonne unten\noder trigger = sundown"| MR["Freigegeben"]
    D0 -->|"Peak freigegeben\noder Sensor liefert keinen\nheutigen Ladestart"| MR
    D0 -->|"Betriebsart = Morgendliches Entladen"| DE{"SoC > Arbeitsgrenze\nund Export > Schwelle?"}
    DE -->|ja| MD["Entladen"]
    DE -->|nein| MN["Nicht nachladen"]

    D0 -->|"Betriebsart = Nur Peak"| DP{"SoC <= Untergrenze?"}
    DP -->|ja| MC["Nachladen\n= Freigegeben-Register"]
    DP -->|nein| DP2{"SoC >= Arbeitsgrenze?"}
    DP2 -->|ja| MN
    DP2 -->|nein| DP3["Readback halten\nsonst Nicht nachladen"]

    MR --> G3
    MD --> G3
    MC --> G3
    MN --> G3
    DP3 --> G3

    G3{"Readback lesbar?\n(nicht unavailable/unknown)"}
    G3 -->|nein| E3([Ende · keine Evidenz])

    G3 -->|ja| G3b{"soc / grid / Ladestart-Sensor\nverfuegbar?"}
    G3b -->|nein| E3b([Ende · keine Evidenz])

    G3b -->|ja| G4{"Sollmodus != Readback?"}
    G4 -->|nein| E4([Ende · stimmt bereits])

    G4 -->|ja| G5{"Mindesthaltezeit abgelaufen?\n(entfaellt wenn Soll oder Ist\n= Freigegeben)"}
    G5 -->|nein| E5([Ende · noch halten])

    G5 -->|ja| W1{"Soll != Freigegeben?"}
    W1 -->|ja| WD["command_timeout neu berechnen\n& schreiben"]
    W1 -->|nein| WM
    WD --> WM

    WM["command_mode = Sollmodus\nschreiben"]
    WM --> E7([Ende])

    subgraph MODES["Vier Regelzustaende auf drei Registerwerten"]
        direction LR
        MM1["Freigegeben\n= Maximize Self Consumption (7)\nRegelung schraenkt nichts ein"]
        MM4["Nachladen\n= Maximize Self Consumption (7)\nHaus zuerst vom Dach,\nUeberschuss in den Akku"]
        MM2["Nicht nachladen\n= Discharge to Minimize Import (5)\ndeckt Hauslast, laedt nicht"]
        MM3["Entladen\n= Discharge to Maximize Export (4)\nspeist aktiv ins Netz"]
    end

    subgraph LEVELS["Zwei Ebenen ueber der Backup-Reserve"]
        direction LR
        B1["Untergrenze = Backup-Reserve + Offset\nnur Nur Peak: Nachladen beginnt"]
        B2["Arbeitsgrenze = Backup-Reserve + Arbeitsreserve\nNur Peak: Nachladen endet\nEntladen: Export endet"]
        B3["10 % / 2 % / 10 % ergibt 12 und 20"]
        B4["Spanne dazwischen = Energie,\ndie dem Haus vorbehalten bleibt\nund nie exportiert wird"]
        B5["Nur Peak haelt sie per Hysterese,\nEntladen gibt sie einmalig ans Haus ab"]
        B6["Backup-Reserve ist der Boden;\nkein Regelmodus kann darunter"]
    end

    subgraph STATE["Einziger gespeicherter Zustand"]
        direction LR
        S1["input_boolean Peak freigegeben"]
        S2["nicht herleitbar, weil optimal_start\nim Tagesverlauf wandert\n(beobachtet: 7 Spruenge in 5,5 h)"]
        S3["Reset bei Sonnenaufgang,\nSonnenuntergang und nachts"]
    end

    subgraph RELEASE["Freigabezeitpunkt"]
        direction LR
        R1["release_ts = Sensorwert unveraendert"]
        R2["kein Vorlauf und keine Untergrenze —\nsie feuerten vor den staerksten\nStunden und fuellten die Batterie im\nFenster, das leer bleiben sollte"]
        R3["fallback_peak bleibt harte Deadline"]
    end

    subgraph GUARD["Schlechtwetter-Guard steckt im Sensor"]
        direction LR
        GA["Sensor veroeffentlicht keinen Start,\nwenn die Restprognose den Ladebedarf\nnicht deckt — oder kein Bedarf besteht"]
        GB["=> keine eigene kWh-Schwelle;\neine feste Schwelle waere jeden\nNachmittag zwangsweise gerissen"]
        GC["Nebeneffekt: die Entladung ist\nselbstbegrenzend — sinkt der SoC,\nsteigt der Bedarf, und sobald die\nPrognose ihn nicht mehr deckt,\nverstummt der Sensor"]
    end

    subgraph PREREQ["Einmalig manuell, nicht Teil der Automation"]
        direction LR
        P1["Storage Control Mode = Remote Control\n(Register 57348)"]
        P2["Storage Default Mode =\nMaximize Self Consumption\n(Register 57354)"]
        P3["fehlt Schritt 1, folgt der\ncommand_mode den Writes nicht —\ndort zuerst nachsehen"]
    end
